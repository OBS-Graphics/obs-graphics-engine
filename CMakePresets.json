{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-tests",
            "displayName": "Debug + Tests",
            "inherits": "debug",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "Release with Debug Info",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug",          "configurePreset": "debug",          "jobs": 0 },
        { "name": "debug-tests",    "configurePreset": "debug-tests",    "jobs": 0 },
        { "name": "release",        "configurePreset": "release",        "jobs": 0 },
        { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "jobs": 0 }
    ]
}